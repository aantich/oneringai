{
  "name": "oneringai-amos",
  "version": "0.1.0",
  "description": "Terminal-based agent app powered by OneRingAI",
  "type": "module",
  "main": "dist/index.js",
  "files": [
    "dist",
    "data/prompts",
    "data/tools",
    "docs",
    "README.md"
  ],
  "bin": {
    "amos": "./dist/index.js"
  },
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "prepack": "npm run build",
    "dev": "LOG_FILE=./data/logs/amos.log LOG_LEVEL=debug tsx src/index.ts",
    "dev:verbose": "LOG_FILE=./data/logs/amos.log LOG_LEVEL=trace tsx src/index.ts",
    "dev:console": "LOG_LEVEL=info tsx src/index.ts",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "oneringai": "file:../..",
    "chalk": "^5.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "tsup": "^8.0.1",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": {
    "name": "Anton Antic",
    "email": "anton.antich@gmail.com"
  },
  "license": "MIT",
  "private": true
}
