{
  "name": "@everworker/oneringai",
  "version": "1.2.0",
  "description": "Unified TypeScript AI agent library with multi-vendor models, tools, memory, media, and pluggable OneRingAI/Codex agent runtimes",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./agents": {
      "types": "./dist/capabilities/agents/index.d.ts",
      "import": "./dist/capabilities/agents/index.js",
      "require": "./dist/capabilities/agents/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.cjs"
    },
    "./images": {
      "types": "./dist/capabilities/images/index.d.ts",
      "import": "./dist/capabilities/images/index.js",
      "require": "./dist/capabilities/images/index.cjs"
    },
    "./agent-runtime": {
      "types": "./dist/agent-runtime/index.d.ts",
      "import": "./dist/agent-runtime/index.js",
      "require": "./dist/agent-runtime/index.cjs"
    },
    "./agent-runtime/codex": {
      "types": "./dist/agent-runtime/codex.d.ts",
      "import": "./dist/agent-runtime/codex.js",
      "require": "./dist/agent-runtime/codex.cjs"
    },
    "./realtime-browser": {
      "types": "./dist/realtime-browser/index.d.ts",
      "import": "./dist/realtime-browser/index.js",
      "require": "./dist/realtime-browser/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "./dist/types/index.d.ts"
      ],
      "shared": [
        "./dist/shared/index.d.ts"
      ],
      "agents": [
        "./dist/capabilities/agents/index.d.ts"
      ],
      "images": [
        "./dist/capabilities/images/index.d.ts"
      ],
      "agent-runtime": [
        "./dist/agent-runtime/index.d.ts"
      ],
      "agent-runtime/codex": [
        "./dist/agent-runtime/codex.d.ts"
      ],
      "realtime-browser": [
        "./dist/realtime-browser/index.d.ts"
      ]
    }
  },
