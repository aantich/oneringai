{
  "name": "@everworker/oneringai",
  "version": "1.1.8",
  "description": "Unified TypeScript AI agent library with multi-vendor models, tools, memory, media, and pluggable OneRingAI/Codex agent runtimes",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./agents": {
      "types": "./dist/capabilities/agents/index.d.ts",
      "import": "./dist/capabilities/agents/index.js",
      "require": "./dist/capabilities/agents/index.cjs"
    },
    "./types": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/types/index.js",
      "require": "./dist/types/index.cjs"
    },
    "./shared": {
      "types": "./dist/shared/index.d.ts",
      "import": "./dist/shared/index.js",
      "require": "./dist/shared/index.cjs"
    },
    "./images": {
      "types": "./dist/capabilities/images/index.d.ts",
      "import": "./dist/capabilities/images/index.js",
      "require": "./dist/capabilities/images/index.cjs"
    },
    "./agent-runtime": {
      "types": "./dist/agent-runtime/index.d.ts",
      "import": "./dist/agent-runtime/index.js",
      "require": "./dist/agent-runtime/index.cjs"
    },
    "./agent-runtime/codex": {
      "types": "./dist/agent-runtime/codex.d.ts",
      "import": "./dist/agent-runtime/codex.js",
      "require": "./dist/agent-runtime/codex.cjs"
    },
    "./realtime-browser": {
      "types": "./dist/realtime-browser/index.d.ts",
      "import": "./dist/realtime-browser/index.js",
      "require": "./dist/realtime-browser/index.cjs"
    }
  },
  "typesVersions": {
    "*": {
      "types": [
        "./dist/types/index.d.ts"
      ],
      "shared": [
        "./dist/shared/index.d.ts"
      ],
      "agents": [
        "./dist/capabilities/agents/index.d.ts"
      ],
      "images": [
        "./dist/capabilities/images/index.d.ts"
      ],
      "agent-runtime": [
        "./dist/agent-runtime/index.d.ts"
      ],
      "agent-runtime/codex": [
        "./dist/agent-runtime/codex.d.ts"
      ],
      "realtime-browser": [
        "./dist/realtime-browser/index.d.ts"
      ]
    }
  },
  "files": [
    "dist",
    "AGENTS.md",
    "CLAUDE.md",
    "README.md",
    "USER_GUIDE.md",
    "API_REFERENCE.md",
    "docs/CONNECTOR_TOOL_CATALOG.md",
    "docs/MEMORY_GUIDE.md",
    "docs/MEMORY_API.md",
    "docs/MEMORY_PERMISSIONS.md",
    "docs/MEMORY_PREDICATES.md",
    "docs/MEMORY_SIGNALS.md",
    "docs/MODEL_REGISTRY_AUDIT.md",
    "docs/designs/AGENT_RUNTIME.md",
    "docs/designs/DISTRIBUTED_AGENT_EXECUTION.md",
    "examples/agent-runtime-local.ts",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "generate:tools": "tsx scripts/generate-tool-registry.ts",
    "generate:vendors": "tsx scripts/generate-vendor-registry.ts",
    "generate": "npm run generate:tools && npm run generate:vendors",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:verify-exports": "node scripts/verify-package-exports.mjs",
    "build": "npm run generate && npm run clean:dist && tsup && npm run build:verify-exports",
    "build:all": "npm run build && npm run --prefix apps/amos build && npm run --prefix apps/hosea build && npm run --prefix apps/convert build",
    "dev": "npm run generate && npm run clean:dist && tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:unit:coverage": "vitest run tests/unit --coverage",
    "test:integration": "vitest run tests/integration",
    "test:realtime:e2e": "RUN_LIVE_OPENAI_REALTIME_E2E=1 vitest run tests/integration/voice/OpenAIRealtimeVoiceAgent.e2e.integration.test.ts",
    "test:oauth": "vitest run tests/unit/oauth",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test:unit && npm run docs && npm run release:verify-tag",
    "preversion": "npm run build && npm run typecheck",
    "version": "npm run generate && npm run docs && git add src/tools/registry.generated.ts src/connectors/vendors/registry.generated.ts API_REFERENCE.md",
    "postversion": "git push --follow-tags",
    "release:verify-tag": "node scripts/verify-release-tag.mjs",
    "release:patch": "npm version patch --git-tag-version=true -m 'Release %s'",
    "release:minor": "npm version minor --git-tag-version=true -m 'Release %s'",
    "release:major": "npm version major --git-tag-version=true -m 'Release %s'",
    "example:agent": "tsx examples/basic-agent.ts",
    "example:agent-runtime": "tsx examples/agent-runtime-local.ts",
    "example:text": "tsx examples/simple-text.ts",
    "example:conversation": "tsx examples/multi-turn-conversation.ts",
    "example:chat": "tsx examples/interactive-chat.ts",
    "example:vision": "tsx examples/vision-image-input.ts",
    "example:providers": "tsx examples/multi-provider-comparison.ts",
    "example:json-tool": "tsx examples/json-manipulation-tool.ts",
    "example:hooks": "tsx examples/agent-with-hooks.ts",
    "example:realtime": "tsx examples/openai-realtime.ts",
    "example:web": "tsx examples/web-research-agent.ts",
    "example:oauth": "tsx examples/oauth-demo.ts",
    "example:oauth-registry": "tsx examples/oauth-registry-demo.ts",
    "example:oauth-static": "tsx examples/oauth-static-tokens.ts",
    "example:oauth-multi-user": "tsx examples/oauth-multi-user.ts",
    "example:oauth-multi-user-fetch": "tsx examples/oauth-multi-user-fetch.ts",
    "example:custom-infrastructure": "tsx examples/custom-infrastructure.ts",
    "example:provider-config": "tsx examples/provider-config-generator.ts",
    "example:logging": "tsx examples/logging-demo.ts",
    "examples:check": "tsc --noEmit -p examples/tsconfig.json",
    "docs": "tsx scripts/generate-api-docs.ts --mode public",
    "docs:public": "tsx scripts/generate-api-docs.ts --mode public",
    "docs:full": "mkdir -p docs && tsx scripts/generate-api-docs.ts --mode full"
  },
  "keywords": [
    "ai",
    "ai-agents",
    "llm",
    "agents",
    "openai",
    "codex",
    "anthropic",
    "claude",
    "gpt",
    "gpt-4",
    "gpt-5",
    "gemini",
    "google-ai",
    "deepseek",
    "groq",
    "ollama",
    "image-generation",
    "dall-e",
    "text-to-speech",
    "speech-to-text",
    "video-generation",
    "sora",
    "tool-calling",
    "function-calling",
    "agentic",
    "agent-runtime",
    "agent-sdk",
    "multi-vendor",
    "mcp",
    "model-context-protocol",
    "rag",
    "chatbot",
    "conversational-ai"
  ],
  "author": {
    "name": "Anton Antic",
    "email": "anton@everworker.ai"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/aantich/oneringai.git"
  },
  "homepage": "https://oneringai.io",
  "bugs": {
    "url": "https://github.com/aantich/oneringai/issues"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.116.0",
    "@google/genai": "^2.19.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@mozilla/readability": "^0.6.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "cheerio": "^1.1.2",
    "clipboardy": "^5.0.2",
    "dotenv": "^17.2.3",
    "eventemitter3": "^5.0.1",
    "exceljs": "^4.4.0",
    "glob": "^13.0.6",
    "jose": "^6.1.3",
    "jsdom": "^29.1.1",
    "officeparser": "^7.8.0",
    "openai": "^7.10.0",
    "pngjs": "^7.0.0",
    "readline-async": "^0.1.0",
    "simple-icons": "^16.7.0",
    "turndown": "^7.2.2",
    "unpdf": "^1.4.0",
    "ws": "^8.21.3",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@faker-js/faker": "^9.9.0",
    "@openai/codex-sdk": "^0.149.0",
    "@types/jsdom": "^27.0.0",
    "@types/node": "^22.10.0",
    "@types/pngjs": "^6.0.5",
    "@types/turndown": "^5.0.6",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^3.2.7",
    "eslint": "^8.56.0",
    "ts-morph": "^27.0.2",
    "tsup": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3",
    "vitest": "^3.2.7"
  },
  "peerDependencies": {
    "@openai/codex-sdk": "^0.149.0",
    "@nut-tree-fork/nut-js": ">=4.0.0",
    "mongodb": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "@openai/codex-sdk": {
      "optional": true
    },
    "@nut-tree-fork/nut-js": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    }
  },
  "overrides": {
    "@hono/node-server": "^2.1.1",
    "body-parser": "^2.3.0",
    "brace-expansion@<2": "1.1.18",
    "brace-expansion@>=2 <3": "2.1.4",
    "brace-expansion@>=3": "5.0.9",
    "exceljs": {
      "uuid": "^11.1.1"
    },
    "express-rate-limit": "^8.7.0",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.5",
    "hono": "^4.13.5",
    "ip-address": "^10.7.0",
    "js-yaml": "^4.3.1",
    "pdfjs-dist": "^6.3.289",
    "protobufjs": "^7.6.6",
    "qs": "^6.16.0",
    "tmp": "^0.2.7",
    "undici": "^7.29.0"
  },
  "engines": {
    "node": "^22.13.0 || >=24.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "allowScripts": {
    "@google/genai@2.19.0": true,
    "esbuild@0.28.2": true,
    "fsevents@2.3.3": true,
    "protobufjs@7.6.6": true,
    "tesseract.js@7.0.0": true
  }
}
