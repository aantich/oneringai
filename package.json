  "scripts": {
    "generate:tools": "tsx scripts/generate-tool-registry.ts",
    "generate:vendors": "tsx scripts/generate-vendor-registry.ts",
    "generate": "npm run generate:tools && npm run generate:vendors",
    "clean:dist": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build:verify-exports": "node scripts/verify-package-exports.mjs",
    "build": "npm run generate && npm run clean:dist && tsup && npm run build:verify-exports",
    "build:all": "npm run build && npm run --prefix apps/amos build && npm run --prefix apps/hosea build && npm run --prefix apps/convert build",
    "dev": "npm run generate && npm run clean:dist && tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "test:unit": "vitest run tests/unit",
    "test:unit:coverage": "vitest run tests/unit --coverage",
    "test:agentic:compat": "tsc --noEmit -p tests/fixtures/agentic-baseline/tsconfig.json",
    "test:context:live": "RUN_CONTEXT_FRESHNESS_LIVE=1 vitest run tests/integration/text/ContextFreshness.live.integration.test.ts",
    "example:context-freshness": "tsx examples/context-compaction-freshness.ts",
    "example:amos-context": "tsx apps/amos/examples/context-budget-offline.ts",
    "test:agentic:live": "RUN_AGENTIC_BASELINE_LIVE=1 vitest run tests/integration/text/AgenticBaseline.live.integration.test.ts",
    "test:integration": "vitest run tests/integration",
    "test:realtime:e2e": "RUN_LIVE_OPENAI_REALTIME_E2E=1 vitest run tests/integration/voice/OpenAIRealtimeVoiceAgent.e2e.integration.test.ts",
    "test:oauth": "vitest run tests/unit/oauth",
    "lint": "eslint \"src/**/*.ts\"",
    "typecheck": "tsc --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run build && npm run typecheck && npm run test:unit && npm run docs && npm run release:verify-tag",
    "preversion": "npm run build && npm run typecheck",
    "version": "npm run generate && npm run docs && git add src/tools/registry.generated.ts src/connectors/vendors/registry.generated.ts API_REFERENCE.md",
    "postversion": "git push --follow-tags",
    "release:verify-tag": "node scripts/verify-release-tag.mjs",
    "release:patch": "npm version patch --git-tag-version=true -m 'Release %s'",
