  "reviewCorrections": [
    "Dispatch and visible-definition scope enforcement; nested intersection and rollback",
    "Independent raw tool observations before public listeners; admission effect/argument capture",
    "Both strict reflection boolean/score, retained-response recheck, separate warning quality",
    "Condition checks, true skip metadata, false dependency values, full nested static preflight",
    "Absolute nested verification deadlines and serialized non-consuming rejected authorization",
    "Final gate on early failed pre-step; cleanup retries bookkeeping without action replay",
    "Nested temporary-memory restoration and execution IDs for repeated task IDs",
    "Late work/receipt correlation survives close; undelivered sources protected until archival",
    "Queued async continuation uses original task; close cancels delivery without model replay",
    "Bounded model-facing references and usage omission diagnostics"
  ],
  "supportBoundaries": [
    "Same-process only; no C3-R workflow backend",
    "Host verification/archival truth is host responsibility",
    "JSON view allowance is not a whole-process heap bound",
    "Borrowed Agent/context/backend handles must not be mutated independently while leased",
    "Source archive assertion cannot waive actual context tool-evidence acknowledgement",
    "No ICOS app edit, dependency upgrade, breaking API or release"
  ],
