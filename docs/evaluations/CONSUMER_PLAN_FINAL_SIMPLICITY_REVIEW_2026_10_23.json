  "findings": [
    {
      "id": "D01",
      "priority": "P2",
      "decision": "Reuse direct-call signal/task; managed-only cancellation bridge and selected composition admission guard.",
      "status": "resolved-in-plan-design-not-runtime"
    },
    {
      "id": "D02",
      "priority": "P1",
      "decision": "Explicit source-tagged static registration, nonempty actual-name identity filter, catalog disabled; mandatory manager-local C5 catalog gate.",
      "status": "resolved-in-plan-design-not-runtime"
    },
    {
      "id": "D03",
      "priority": "P1",
      "decision": "Single C6 identity/tool/storage/timeout/board ownership table; deliberate shared evidence/tasks versus exclusive conversation state.",
      "status": "resolved-in-plan-design-not-runtime"
    },
    {
      "id": "D04",
      "priority": "P1",
      "decision": "Non-consuming failed continuation admission, single successor and retained correlated recovery; no effect replay.",
      "status": "resolved-in-plan-design-not-runtime"
    },
    {
      "id": "D05",
      "priority": "P2",
      "decision": "One bounded observation set and phase views/references, no quadratic copies or new journal/backend.",
      "status": "resolved-in-plan-design-not-runtime"
    },
    {
      "id": "D06",
      "priority": "P2",
      "decision": "Variable-safe never fields, discriminated request types, runtime checks and async worker name/capacity reservations.",
      "status": "resolved-in-plan-design-not-runtime"
    },
    {
      "id": "D07",
      "priority": "P2",
      "decision": "Logical page fetch versus physical retries; no automatic next page, blanket bound rewrite or new routine deadline from zero.",
      "status": "resolved-in-plan-design-not-runtime"
    },
    {
      "id": "D08",
      "priority": "P2",
      "decision": "Conformance required for current in-memory/file/restart backends; optional shared-backend support only after actual adapter validation.",
      "status": "resolved-in-plan-design-not-runtime"
    },
    {
      "id": "D09",
      "priority": "P2",
      "decision": "One normative document owner per contract; sparse capability projections, reused parameter facts, pure presentation without registries/DSL/theme framework.",
      "status": "resolved-in-plan-design-not-runtime"
    }
  ],
