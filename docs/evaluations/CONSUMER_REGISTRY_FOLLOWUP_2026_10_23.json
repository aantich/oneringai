  "planDecisions": [
    {
      "id": "C6",
      "decision": "Replace the unimplemented built-Agent callback proposal with configureAgent returning complete host-selected config before plugin/tool/lifecycle initialization. Explicit precedence, required workspace/tool ownership and provider/account/authority isolation. Preserve old constructors/callbacks."
    },
    {
      "id": "C9-A",
      "decision": "Independent endpoint/model/transport capability companion, verified/unsupported/unknown distinct. No changes to old raw registry/session unions, saved values, admission or generic STT streaming. Exact 2.1/mini efforts remain unverified."
    },
    {
      "id": "C9-B",
      "decision": "Independent public effective-request assessment plus opt-in neutral-temperature omission. Preserve intentional strict generation validation and explicit raw controls. Cover native-count divergence and routed/overridden requests."
    },
    {
      "id": "C9-C",
      "decision": "Independent browser-safe vendor presentation catalog with host overrides. Preserve vendor identity, generic custom-service ownership, service/auth classification and approved consumer labels/colors."
    }
  ],
