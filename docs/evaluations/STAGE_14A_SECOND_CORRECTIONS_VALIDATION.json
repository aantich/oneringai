  "authorization": "User fix all following second Stage 14A review; S1\u2013S3 only, additive and compatibility preserving. No 14B/16B, breaking API, commit/push/publication.",
  "findings": [
    {
      "id": "S1",
      "priority": "P1",
      "status": "fixed",
      "change": "Captured protocol-aware response replacement preserves ordered repaired replay items and admitted owner, rejects stale boundaries, keeps portable hooks and legacy public content-only helper. Empty original output appends journal correction without replacing an earlier tool receipt."
    },
    {
      "id": "S2",
      "priority": "P1",
      "status": "fixed",
      "change": "Retains original task/route/effective options on failed event retries and all budget/preparation/hook admission failures; releases on successful completion/terminal stream closure or explicit host cancellation. Never undoes or replays the observed action."
    },
    {
      "id": "S3",
      "priority": "P2",
      "status": "fixed",
      "change": "Finalizes structured suspension before checkpoint/correlation/success event in ordinary and selected context. Failed finalization retains observation/correlation with optional recovery diagnostic; dual failures retain both errors. Storage errors remain explicit."
    }
  ],
  "compatibility": {
    "breakingChanges": false,
    "newRequiredProviderOrStorageMembers": false,
    "sessionVersionMigration": false,
    "defaultRoutingEnabled": false,
    "preserved": [
      "supported public signatures and defaults",
      "legacy provider/storage and optional journal contracts",
      "public content-only replacement behavior",
      "portable history hooks",
      "direct/idle/helper ownership",
      "parse-only JSON coercion",
      "no JSON repair in streaming"
    ],
    "optionalFailureMetadata": "state.metadata.suspensionFinalization contains status failed, correlationId and SessionRef fields. Diagnostic only: no restored task/policy/authorization authority.",
    "failureBoundary": "Preserve actual observations before teardown when a backend fails. No action replay; cancellation is not proof an external action was undone. A failing backend cannot guarantee restart durability."
  },
