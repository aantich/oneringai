    "script": "import { pathToFileURL } from 'node:url';\nimport {createRequire} from 'node:module';\nimport { writeFile, mkdtemp, rm } from 'node:fs/promises';\nimport { tmpdir } from 'node:os';\nimport { join } from 'node:path';\nconst root='/Users/aantich/dev/oneringai';\nconst reports: unknown[]=[];\nfor(const variant of ['source','public','public-cjs'] as const){\n const lib=variant==='source'?await import(pathToFileURL(root+'/src/index.ts').href):variant==='public-cjs'?createRequire(root+'/package.json')('@everworker/oneringai'):await import('@everworker/oneringai');\n const {AgentContextNextGen,InMemoryEvidenceStorage,ObservationMaskingStrategy,StructuredSummaryStrategy,MessageRole,ContentType}=lib;\n const user=(text:string)=>({type:'message',role:MessageRole.USER,content:[{type:ContentType.INPUT_TEXT,text}]});\n const assistant=(text:string)=>({type:'message',role:MessageRole.ASSISTANT,content:[{type:ContentType.OUTPUT_TEXT,text}]});\n for(const sourceCap of [8192,20000]){\n  const scope={ownerId:'owner',namespace:'review-starvation-'+sourceCap};\n  const storage=new InMemoryEvidenceStorage({scope});\n  const raw={answer:'EXACT_REVIEW_VALUE',padding:'Read observation detail. '.repeat(800)};\n  const reference=await storage.put({version:1,recordedAt:1,source:{toolName:'lookup',callId:'call',executionId:'exec',arguments:{},principal:{userId:'owner'},effect:'read',status:'succeeded',completion:'settled',startedAt:1,durationMs:1},result:raw});\n  const ctx=AgentContextNextGen.create({model:'gpt-4o-mini',userId:'owner',maxContextTokens:7000,responseReserve:128,features:{evidence:true,workingMemory:false,inContextMemory:false},plugins:{evidence:{storage}},compactionStrategy:new ObservationMaskingStrategy({maxSourceTokens:sourceCap})});\n  const exactUser='Original exact user constraints. '.repeat(600);\n  ctx.addInputItems([user(exactUser),{type:'message',role:MessageRole.ASSISTANT,content:[{type:ContentType.TOOL_USE,id:'call',name:'lookup',arguments:'{}'}]},{type:'message',role:MessageRole.USER,content:[{type:ContentType.TOOL_RESULT,tool_use_id:'call',content:raw,evidence:{version:1,status:'stored',executionId:'exec',reference}}]},user('Recent first.'),assistant('OK.'),user('Recent second.'),assistant('OK.')]);\n  const tokenSizes=ctx.getState().conversation.map((item:unknown)=>ctx.estimateItemTokens(item));\n  let error;try{await ctx.prepare();}catch(e){error=(e as Error).message;}\n  const entries=(await storage.list()).entries;const sources=[];\n  for(const e of entries)if(e.toolName==='__context_source__'){const r=await storage.readRecord(e.reference);sources.push((r.result as {items:unknown[]}).items.length);}\n  reports.push({variant,case:'source-budget-starvation',sourceCap,tokenSizes,error,applied:ctx.lastPreparation?.compaction?.applied??false,retainedSourceItemCounts:sources,exactUserRetained:JSON.stringify(ctx.getState()).includes(exactUser),rawRetained:JSON.stringify(ctx.getState()).includes(raw.padding)});ctx.destroy();\n }\n for(const mode of ['mask','summary']){\n  let helperCallbacks=0;\n  const storage=new InMemoryEvidenceStorage({scope:{ownerId:'owner',namespace:'review-noop-'+mode},maxRecords:2});\n  const ctx=AgentContextNextGen.create({model:'gpt-4o-mini',userId:'owner',maxContextTokens:2000,responseReserve:128,criticalCompactionThreshold:0.8,features:{evidence:true,workingMemory:false,inContextMemory:false},plugins:{evidence:{storage}},compactionStrategy:mode==='mask'?new ObservationMaskingStrategy():new StructuredSummaryStrategy()});\n  ctx.addInputItems([user('Exact unchanged user constraint. '.repeat(130)),user('Recent first.'),assistant('OK.'),user('Recent second.'),assistant('OK.')]);const cycles=[];const unchanged=JSON.stringify(ctx.getState().conversation);\n  for(let i=0;i<3;i++){let error;try{await ctx.prepare({summarize:async(request: any)=>{helperCallbacks++;return {summary:{completedWork:[{text:\"No narrative can be removed.\",sourceIds:[request.reference.id]}],activeWork:[],constraints:[],decisions:[],uncertainties:[],artifacts:[],actionReceipts:[]}};}});}catch(e){error=(e as Error).message;}cycles.push({error,budgetAvailable:error?undefined:ctx.lastPreparation?.budget.available,lastSuccessfulReport:ctx.lastPreparation?.compaction,historyUnchanged:unchanged===JSON.stringify(ctx.getState().conversation),records:(await storage.list()).entries.length});}\n  reports.push({variant,case:'known-noop-storage',mode,helperCallbacks,cycles});ctx.destroy();\n }\n}\nconst {ConfigManager}=await import(pathToFileURL(root+'/apps/amos/src/config/ConfigManager.ts').href);\nconst {ContextCommand}=await import(pathToFileURL(root+'/apps/amos/src/commands/commands/ContextCommand.ts').href);\nconst {AgentRunner}=await import(pathToFileURL(root+'/apps/amos/src/agent/AgentRunner.ts').href);\nconst lib=await import('@everworker/oneringai');\nconst directory=await mkdtemp(join(tmpdir(),'stage07-review-amos-'));\ntry{\nfor(const initialStrategy of ['absent','algorithmic'])for(const selected of ['observation-masking','structured-summary']){\n const caseDirectory=join(directory,initialStrategy+'-'+selected);\n const manager=new ConfigManager(caseDirectory);const config=await manager.load();\n if(initialStrategy==='algorithmic')config.contextStrategy='algorithmic';\n if(selected==='structured-summary')config.modelExecution={helpers:{compactor:{connector:'synthetic-compactor',model:'gpt-4o-mini'}}};config.evidence={enabled:true,directory:join(directory,'evidence'),ownerId:'owner',namespace:'amos'};\n const runner=new AgentRunner(config,[],directory);const ctx=lib.AgentContextNextGen.create({model:'gpt-4o-mini',features:{evidence:true,workingMemory:false,inContextMemory:false},plugins:{evidence:{storage:new lib.InMemoryEvidenceStorage({scope:{ownerId:'owner',namespace:'amos'}})}}});\n // Real runner/command/ConfigManager; only the otherwise-unused model transport is synthetic.\n (runner as any).agent={context:ctx,isRunning:()=>false,destroy:()=>ctx.destroy()};\n const app={getAgent:()=>runner,getConfig:()=>manager.get(),updateConfig:(p:unknown)=>manager.update(p),saveConfig:async()=>{throw new Error('review save failure');}};\n const before={configured:manager.get().contextStrategy,runtime:runner.getContextCompaction().strategy};\n const result=await new ContextCommand().execute({app,args:['strategy',selected],rawInput:'/context strategy '+selected} as any);\n const after={configured:manager.get().contextStrategy,runtime:runner.getContextCompaction().strategy};\n await manager.save();const persisted=(await new ConfigManager(caseDirectory).load()).contextStrategy;\n reports.push({case:'amos-failed-persistence',initialStrategy,selected,before,result,after,persistedOnNextSave:persisted});runner.destroy();\n}\n}finally{await rm(directory,{recursive:true,force:true});}\nfor(const variant of ['source','public','public-cjs']){\n const rows=reports as any[];\n const starved=rows.find(r=>r.variant===variant&&r.case==='source-budget-starvation'&&r.sourceCap===8192);\n const control=rows.find(r=>r.variant===variant&&r.case==='source-budget-starvation'&&r.sourceCap===20000);\n if(!starved.error?.includes('Context overflow')||starved.retainedSourceItemCounts[0]!==1||!control.applied||!control.exactUserRetained||control.rawRetained)throw new Error('Starvation reproduction or control changed');\n for(const mode of ['mask','summary']){\n  const noop=rows.find(r=>r.variant===variant&&r.case==='known-noop-storage'&&r.mode===mode);\n  if(noop.cycles[0].error||noop.cycles[1].error||noop.cycles[0].lastSuccessfulReport?.applied||noop.cycles[1].lastSuccessfulReport?.applied||!noop.cycles[2].error?.includes('Cannot retain')||noop.helperCallbacks!==(mode==='summary'?2:0))throw new Error('No-op quota reproduction changed');\n }\n}\nfor(const rollback of (reports as any[]).filter(r=>r.case==='amos-failed-persistence')){\n const expected=rollback.initialStrategy==='absent'?rollback.selected:'algorithmic';\n if(rollback.result.success||rollback.after.configured!==expected||rollback.after.runtime!=='algorithmic'||rollback.persistedOnNextSave!==expected)throw new Error('Rollback reproduction/control changed');\n}\nawait writeFile('/tmp/oneringai-stage07-review-reproductions.json',JSON.stringify(reports,null,2)+'\\n');console.log(JSON.stringify(reports));\n",
