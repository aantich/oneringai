      "id": "R1",
      "priority": "P1",
      "title": "Release build embeds an outdated MCP client despite a passing clean-consumer audit",
      "locations": [
        {
          "file": "tsup.config.ts",
          "line": 53
        },
        {
          "file": "package.json",
          "line": 621
        },
        {
          "file": "src/core/mcp/MCPClient.ts",
          "line": 547
        }
      ],
      "observedBuildSdkVersion": "1.30.0",
      "patchedSdkFloor": "1.32.0",
      "advisory": "https://github.com/modelcontextprotocol/typescript-sdk/security/advisories/GHSA-6prh-2h8m-c8cw",
      "effect": "Public MCPRegistry HTTP client follows a cross-origin 307 and forwards a synthetic secret custom header and initialization body. SDK is embedded by noExternal; auditing freshly installed dependency packages does not audit that embedded copy.",
      "reproduction": {
        "source": "http://127.0.0.1:53855",
        "target": "http://127.0.0.1:53854",
        "crossOrigin": true,
        "captured": [
          {
            "header": "synthetic-release-fixture",
            "body": "{\"method\":\"initialize\",\"params\":{\"protocolVersion\":\"2025-11-25\",\"capabilities\":{},\"clientInfo\":{\"name\":\"oneringai\",\"version\":\"0.2.0\"}},\"jsonrpc\":\"2.0\",\"id\":0}"
          }
        ],
        "error": "MCPConnectionError: Failed to connect to MCP server 'offline-redirect-probe'",
        "leakedSyntheticHeader": true
      },
      "requiredWork": "Use a patched compatible MCP SDK for the build, raise the dependency floor, rebuild, and validate bundled dependency provenance plus an actual packaged MCP redirect regression. Assess remaining exact-build advisories for shipped paths."
    },
    {
      "id": "R2",
      "priority": "P2",
      "title": "Referenced schema subtrees outside ordinary schema keywords skip nested admission and normalization",
      "locations": [
        {
          "file": "src/infrastructure/runtime/schemaCompiler.browser.ts",
          "line": 29
        },
        {
          "file": "src/infrastructure/runtime/schemaCompiler.browser.ts",
          "line": 97
        }
      ],
      "minimalValidSchema": {
        "$ref": "#/default",
        "default": {
          "type": "object",
          "properties": {
            "currency": {
              "type": "string",
              "nullable": true
            }
          },
          "required": [
            "currency"
          ]
        }
      },
      "value": {
        "currency": null
      },
      "effect": "Node accepts the valid value; browser page/Worker reject it after bounded repair. A nested missing reference is rejected before dispatch on Node but after a model call in the browser. Both primary schema and optional local validationSchema are affected.",
      "requiredWork": "Index and process every actually referenced schema subtree and descendants with the correct lexical scope, reusing the existing admission/normalization path; leave unreferenced annotation data unchanged. Add primary/local validation and before-dispatch regressions."
    },
    {
      "id": "R3",
      "priority": "P3",
      "title": "Empty schema IDs incorrectly create duplicate-ID cache entries",
      "locations": [
        {
          "file": "src/infrastructure/runtime/schemaCompiler.browser.ts",
          "line": 195
        }
      ],
      "schemas": [
        {
          "$id": "",
          "type": "string"
        },
        {
          "$id": "",
          "type": "number"
        }
      ],
      "effect": "Native compiler accepts both schemas in one compiler. Browser compiler rejects the second. The same applies to $id=\"#\". Latent in the current public helper path, which compiles one root per local compiler.",
      "requiredWork": "Match native AJV identity handling for empty or fragment-only IDs without changing ordinary duplicate-ID rejection or weak identity caching."
    }
